{
  "name": "@umicloud/renovate-config",
  "version": "0.1.0",
  "description": "Preset for Renovate",
  "homepage": "https://github.com/umicloud/renovate-config",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/umicloud/renovate-config.git"
  },
  "files": [
    "default.json"
  ],
  "type": "module",
  "scripts": {
