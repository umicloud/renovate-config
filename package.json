{
  "name": "@umicloud/renovate-config",
  "version": "0.0.1",
  "description": "Presets for Renovate",
  "homepage": "https://github.com/umicloud/renovate-config",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/umicloud/renovate-config.git"
  },
  "files": [
    "default.json"
  ],
  "type": "module",
  "scripts": {
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "test": "renovate-config-validator default.json",
    "release": "bumpp && bun publish --access public",
    "prepare": "bun run test"
  },
  "devDependencies": {
    "bumpp": "latest",
    "oxfmt": "latest",
    "renovate": "latest"
  }
}
